# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=your_secure_password_here

# Mongo Express Configuration
ME_CONFIG_MONGODB_ADMINUSERNAME=admin
ME_CONFIG_MONGODB_ADMINPASSWORD=your_secure_password_here
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=your_express_password_here

# Database Configuration
DATABASE_URL=mongodb://localhost:27017/ultralytics_annotation
DATABASE_NAME=dataset_annotation

# Google Cloud Settings
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json
GCP_PROJECT_ID=your-gcp-project-id
STORAGE_BUCKET=your-bucket-name

# Application Settings
DEBUG=True
ENVIRONMENT=development

# API Settings
API_V1_STR=/api/v1

# YOLO11 Model Configuration
YOLO11_MODEL_PATH=yolo11n.pt
YOLO11_DEFAULT_MODEL=yolo11n.pt
YOLO11_PRODUCTION_MODEL=yolo11m.pt
